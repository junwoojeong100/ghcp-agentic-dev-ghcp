[428.967216, "o", "\u001b[?25l\u001b[1;19r\u001b[19;1H\r\n\u001b[1;24r\u001b[8;112H┃\r\r\n\u001b[111C┃\r\u001b[17;98H문 내용은\r\n   충돌로 거절하며, 별도 키는 새 주문을\r\n\u001b[111C\u001b[37m┃\r\u001b[24;2H\u001b[34m◉\u001b[24;16H\u001b[m1\u001b[22;3H\u001b[?25h"]
[429.001083, "o", "\u001b[?25l\u001b[18;41H만듭니다. 검토한 변경은 허\u001b[22;3H\u001b[?25h"]
[429.033657, "o", "\u001b[?25l\u001b[1;19r\u001b[19;1H\r\n\u001b[1;24r\u001b[9;112H┃\r\u001b[17;67H용된 네 파일에 한정됩니다. **조치가 필요한\r\n   코드 결함은\r\n\u001b[111C\u001b[37m┃\r\u001b[24;16H\u001b[m2 \u001b[22;3H\u001b[?25h"]
[429.072865, "o", "\u001b[?25l\u001b[1;19r\u001b[19;1H\r\n\r\n\u001b[1;24r\u001b[8;112H┃\r\r\n\u001b[111C┃\r\u001b[15;94H\u001b[1m조치가 필요한 \u001b[m \r\n   \u001b[1m코드 결함은 관찰되지 않았습니다.\r\n\r\n\u001b[3C\u001b[m**완\u001b[104C\u001b[37m┃\r\r\n\u001b[111C┃\r\u001b[24;2H\u001b[34m◎\u001b[m \u001b[94mW\u001b[24;16H\u001b[m3\u001b[22;3H\u001b[?25h"]
[429.107087, "o", "\u001b[?25l\u001b[4A \u001b[1m완료 기준과 관측 근거:\u001b[m 제공된 TAP 기록에는\u001b[24;16H5 \u001b[22;3H\u001b[?25h"]
[429.138952, "o", "\u001b[?25l\u001b[1;19r\u001b[19;1H\r\n\u001b[1;24r\u001b[9;112H┃\r\r\n\u001b[111C┃\r\u001b[17;47H저장소 테스트 14/14, acceptance 테스트 16/16 통과가 기록되어\r\n   있습니다. 이 기록은\r\n\u001b[111C\u001b[37m┃\r\u001b[24;2H\u001b[34m○\u001b[m \u001b[34mWo\u001b[94mrk\u001b[m\u001b[22;3H\u001b[?25h"]
[429.17499, "o", "\u001b[?25l\u001b[18;24H키 검증, 순차·동시 재전송, 충돌, 체크아웃\u001b[24;16H6 \u001b[22;3H\u001b[?25h"]
[429.208144, "o", "\u001b[?25l\u001b[18;66H범위, 잘못된 주문 후 재사용과 일부 기\u001b[22;3H\u001b[?25h"]
[429.241107, "o", "\u001b[?25l\u001b[1;19r\u001b[19;1H\r\n\u001b[1;24r\u001b[10;112H┃\r\u001b[17;103H존\r\n   동작을 다룹니다. 다만 `.demo/06-browser-check.jso\r\n\u001b[111C\u001b[37m┃\r\u001b[24;2H\u001b[34m◎\u001b[m \u001b[94mW\u001b[34morki\u001b[94mng\u001b[m\u001b[22;3H\u001b[?25h"]
[429.280511, "o", "\u001b[?25l\u001b[18;26H\u001b[37m .demo/06-browser-check.json \u001b[m은 없고 `.demo/03-ve\u001b[22;3H\u001b[?25h"]
[429.313303, "o", "\u001b[?25l\u001b[18;63H\u001b[37m .demo/03-verification.json \u001b[m도\u001b[24;16H7 \u001b[22;3H\u001b[?25h"]
[429.347279, "o", "\u001b[?25l\u001b[1;19r\u001b[19;1H\r\n\u001b[1;24r\u001b[10;112H┃\r\u001b[17;94H브라우저 검증이\r\n   아니라고 명시합니다. 따라서 AC6–7의 실\r\n\u001b[111C\u001b[37m┃\r\u001b[24;2H\u001b[94m◉\u001b[m \u001b[34mWo\u001b[94mrk\u001b[34ming\u001b[m\u001b[22;3H\u001b[?25h"]
[429.387177, "o", "\u001b[?25l\u001b[18;42H제 브라우저 동작은 관측되\u001b[22;3H\u001b[?25h"]
[429.420475, "o", "\u001b[?25l\u001b[18;67H지 않았으며, 브라우저\r\u001b[6B \u001b[94m●\u001b[m \u001b[34mWorki\u001b[94mng\u001b[m\u001b[22;3H\u001b[?25h"]
[429.458739, "o", "\u001b[?25l\u001b[1;19r\u001b[19;1H\r\n\u001b[1;24r\u001b[10;112H┃\r\u001b[17;89H기록의\r\n   \u001b[37m sourceDigest \u001b[m도 현재\r\n\u001b[111C\u001b[37m┃\r\u001b[24;16H\u001b[m8 \u001b[22;3H\u001b[?25h"]
[429.498586, "o", "\u001b[?25l\u001b[18;26H검증과 대조할 수 없\u001b[22;3H\u001b[?25h"]
[429.530653, "o", "\u001b[?25l\u001b[1;19r\u001b[19;1H\r\n\r\n\u001b[1;24r\u001b[9;112H┃\r\r\n\u001b[111C┃\r\r\n\u001b[111C┃\r\u001b[16;45H습니다.\r\n\r\n   **남은 위\u001b[99C\u001b[37m┃\r\r\n\u001b[111C┃\r\u001b[24;2H\u001b[94m◉\u001b[6C\u001b[34mng\u001b[m\u001b[22;3H\u001b[?25h"]
[429.565847, "o", "\u001b[?25l\u001b[4A \u001b[1m남은 위험과 사람의 판단:\u001b[m 주문 저장은 단일\u001b[24;16H9 \u001b[22;3H\u001b[?25h"]
[429.596901, "o", "\u001b[?25l\u001b[18;46H프로세스 메모리에\r\u001b[6B \u001b[34m◎\u001b[m \u001b[2A\b\u001b[?25h"]
[429.630164, "o", "\u001b[?25l\u001b[18;64H한정됩니다. 사람\u001b[22;3H\u001b[?25h"]
