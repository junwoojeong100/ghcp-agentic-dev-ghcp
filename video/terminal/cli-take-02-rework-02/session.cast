[4.073357, "o", "\u001b[?25l\u001b[H\u001b[2;90m╭────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\r\n│\u001b[108C│\r\n│\u001b[m \u001b[34m ╭─╮╭─╮\u001b[3;38H\u001b[2;90m│\u001b[m  \u001b[1;34mGetting started\u001b[54C\u001b[0;2;90m│\r\n│\u001b[m \u001b[34m ╰─╯╰─╯\u001b[m  Copilot v1.0.88 uses AI.  \u001b[2;90m│\u001b[m  /init — Initialize Copilot instructions for this repository\u001b[10C\u001b[2;90m│\r\n│\u001b[m \u001b[35m █ \u001b[96m▘▝\u001b[35m █\u001b[m  Check for mistakes.\u001b[7C\u001b[2;90m│\u001b[m  /model — Switch models across providers, or use Auto\u001b[17C\u001b[2;90m│\r\n│\u001b[m \u001b[35m  ▔▔▔▔ \u001b[6;38H\u001b[2;90m│\u001b[71C│\r\n│\u001b[108C│\r\n╰───────────────────────────────────────────────────────────────"]
